# Neon connection string — Neon dashboard > your project > Connection Details.
# Use the POOLED connection string (the one with "-pooler" in the host).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Shared passphrase that lets someone open the planner and edit it.
# Any long random string. Everyone in the house uses the same one.
HOUSEHOLD_KEY="change-me-to-something-long-and-random"

# Secret path segment for the read-only calendar feed:
#   https://<your-app>.vercel.app/api/feed/<FEED_TOKEN>.ics
# Calendar apps cannot send headers, so this URL IS the credential.
# Make it long and random, and treat it as a secret.
FEED_TOKEN="change-me-too-at-least-32-random-characters"
