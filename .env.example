# Neon connection string — Neon dashboard > your project > Connection Details.
# Use the POOLED connection string (the one with "-pooler" in the host).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Shared passphrase that lets someone open the planner and edit it.
# Any long random string. Everyone in the house uses the same one.
HOUSEHOLD_KEY="change-me-to-something-long-and-random"

# Secret path segment for the read-only calendar feed:
#   https://<your-app>.vercel.app/api/feed/<FEED_TOKEN>.ics
# Calendar apps cannot send headers, so this URL IS the credential.
# Make it long and random, and treat it as a secret.
FEED_TOKEN="change-me-too-at-least-32-random-characters"

# Natural-language and voice entry. Anthropic console > API keys.
# Without it the app works; the "Just say it" box reports itself unavailable.
ANTHROPIC_API_KEY="sk-ant-..."

# The nightly text. Twilio console; TWILIO_FROM is the number you bought,
# in international form. Without these, nothing is sent and nothing breaks.
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_FROM="+15555550123"

# Signs the nightly cron request. Any long random string; set the SAME value
# in Vercel so its scheduler can call /api/cron/daily.
CRON_SECRET="another-long-random-string"

# SMTP2GO, for emailing the nightly briefing. SENDER must be an address
# SMTP2GO has verified for your account. Either this or Twilio is enough;
# with both, each person gets whichever channels they have.
SMTP2GO_API_KEY="api-..."
SMTP2GO_SENDER="Uma's Planner <planner@yourdomain.com>"
